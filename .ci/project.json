{
  "schema_version": 1,
  "project": {
    "component": "classic",
    "repository": "FelixJI/vibeocr-classic",
    "protocol_compatibility": {
      "supported_majors": [2],
      "minor_compatible": true
    }
  },
  "ci": {
    "bootstrap": [
      ["python", "scripts/resolve_component_releases.py", "--policy", "component-policy.json", "--output-root", "build/automation/release-input"],
      ["python", "scripts/install_resolved_components.py", "--release-input", "build/automation/release-input"]
    ],
    "quality": [["python", "-m", "pytest"]],
    "e2e": [["python", "scripts/verify_component_release_input.py", "--release-input", "build/automation/release-input"]],
    "release_build": [["powershell", "-ExecutionPolicy", "Bypass", "-File", "scripts/build-release.ps1", "-Version", "{version}", "-ReleaseInput", "build/automation/release-input", "-ArtifactsDir", "{artifacts_dir}"]],
    "release_smoke": [
      ["python", "scripts/verify_release_assets.py", "{artifacts_dir}", "--no-checksum-index", "--exact", "--require", "component-lock.json", "--require", "frontend-protocol-lock.json", "--require", "SBOM.spdx.json", "--require", "VibeOCRClassic-win-Setup.exe", "--require", "VibeOCRClassic-win-Setup.exe.sha256", "--require", "VibeOCRClassic-win-Portable.zip", "--require", "releases.win.json", "--require-one", "VibeOCRClassic-*-full.nupkg"],
      ["python", "scripts/verify_velopack_release.py", "{artifacts_dir}", "--version", "{version}"]
    ]
  },
  "release": {
    "version_sources": [
      {"kind": "text", "path": "version.txt"},
      {"kind": "toml", "path": "apps/vibeocr-pyside/pyproject.toml", "key": "project.version"},
      {"kind": "python", "path": "apps/vibeocr-pyside/src/vibeocr/classic/__init__.py", "key": "__version__"},
      {"kind": "json", "path": "repository.json", "key": "version"}
    ],
    "generated_commands": [],
    "identity_asset": "component-lock.json",
    "required_assets": ["component-lock.json", "frontend-protocol-lock.json", "SBOM.spdx.json", "VibeOCRClassic-*-full.nupkg", "VibeOCRClassic-win-Setup.exe", "VibeOCRClassic-win-Setup.exe.sha256", "VibeOCRClassic-win-Portable.zip", "releases.win.json"],
    "mirrors": [
      {"name": "gitee", "url_env": "GITEE_URL", "user_env": "GITEE_USER", "token_env": "GITEE_TOKEN"},
      {"name": "cnb", "url_env": "CNB_URL", "token_env": "CNB_TOKEN", "user": "cnb"}
    ]
  }
}
